# Text stays diffable; binary production assets are stored with Git LFS.
* text=auto
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf

*.[uU][aA][sS][sS][eE][tT] filter=lfs diff=lfs merge=lfs -text lockable
